/*imperative program*/void rechtsUm(){
	linksUm();
	linksUm();
	linksUm();
}

void kehrUm(){
	linksUm();
	linksUm();
}

void tauschen(){
	int rechts = 0;
	int links = 0;
	while(kornDa()){
		nimm();
		rechts++;
	}
	rechtsUm();
	vor();
	while(kornDa()){
		nimm();
		links++;
	}
	while(rechts > 0){
		gib();
		rechts--;
	}
	kehrUm();
	vor();
	while(links > 0){
		gib();
		links--;
	}
	rechtsUm();
}

void zumStart(){
	kehrUm();
	while(zeilen > 0){
		vor();
		zeilen--;
	}
	kehrUm();
}

int zeilen = 0;

void main() { 
    for(int i=0; i<2; i++){
    	while(vornFrei()){
    		tauschen();
    		vor();
    		zeilen++;
    	}
    	tauschen();
    	zumStart();
    }
}