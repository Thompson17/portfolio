/*imperative program*/void kehrUm(){
	linksUm();
	linksUm();
}

void vor2(){
	vor();
	vor();
}

void tauschen(){
	linksUm();
	vor();
	einsHoch();
	vor();
	einsHoch();
	kehrUm();
	vor2();
	zweiRunter();
	linksUm();
}

void einsHoch(){
	while(kornDa()){
		nimm();
	}
	kehrUm();
	vor();
	while(!maulLeer()){
		gib();
	}
	kehrUm();
	vor();
}

void zweiRunter(){
	while(kornDa()){
		nimm();
	}
	kehrUm();
	vor2();
	while(!maulLeer()){
		gib();
	}
	kehrUm();
	vor2();
	}


void main() {
    while(vornFrei()){
    	tauschen();
    	vor();
    }
    tauschen();
}