/*imperative program*/void rechtsUm(){
	linksUm();
	linksUm();
	linksUm();
}

void kehrUm(){
	linksUm();
	linksUm();
}

void vorNimm(int schritte){
	for(int i=0; i < schritte; i++){
		while(kornDa()){
			nimm();
			maul++;
		}
		vor();
	}
}

int maul = 0;

void main() { 
    rechtsUm();
    vorNimm(6);
    linksUm();
    vorNimm(6);
    kehrUm();
    vorNimm(6);
    rechtsUm();
    vorNimm(2);
    rechtsUm();
    vorNimm(11);
    linksUm();
    vorNimm(2);
    linksUm();
    vorNimm(11);
    rechtsUm();
    vorNimm(2);
    rechtsUm();
    vorNimm(11);
    rechtsUm();
    vorNimm(6);
    while(maul > 0){
    	gib();
    	maul--;
    }
}