/*imperative program*/void nimm4(){
	if(kornDa()){
		nimm();
		if(kornDa()){
			nimm();
			if(kornDa()){
				nimm();
				if(kornDa()){
					nimm();
					if(kornDa()){
						gib();
						gib();
						gib();
						gib();
					}
				}else{
					gib();
					gib();
					gib();
				}
			}else{
				gib();
				gib();
			}
		}else{
			gib();
		}
	}
}

void rechtsUm(){
	linksUm();
	linksUm();
	linksUm();
}

void zweiReihen(){
